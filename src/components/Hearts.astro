---
/**
 * Synced hearts (Cloudflare Worker) + view counter (GoatCounter).
 * Every tap increments the global count. Fails silently — decoration, never errors.
 */
import { GOATCOUNTER_CODE, HEARTS_API } from '../lib/analytics';

interface Props {
  postId: string;
}

const { postId } = Astro.props;
---

<div
  class="post-reactions"
  data-post-id={postId}
  data-gc={GOATCOUNTER_CODE}
  data-hearts-api={HEARTS_API}
>
  <button class="heart-btn" id="heart-btn" aria-label="Send a heart">
    <span class="heart-icon" aria-hidden="true">♥</span>
    <span class="heart-count" id="heart-count">–</span>
  </button>
  <span class="heart-note" id="heart-note">hearts from readers</span>
  <span class="view-count" id="view-count" hidden></span>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>('.post-reactions');
  const btn = document.getElementById('heart-btn');
  const countEl = document.getElementById('heart-count');
  const noteEl = document.getElementById('heart-note');
  const viewEl = document.getElementById('view-count');

  if (wrap && btn && countEl) {
    const id = wrap.dataset.postId;
    const api = wrap.dataset.heartsApi;
    const gc = wrap.dataset.gc;
    const localKey = `hearts:${id}`;
    const MAX_TAPS_PER_VISIT = 50; // stay polite to the free tier

    const setCount = (n: number) => {
      countEl.textContent = String(n);
    };

    // initial load
    if (api) {
      fetch(`${api}/hearts/${id}`)
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => setCount(d ? d.count : 0))
        .catch(() => setCount(parseInt(localStorage.getItem(localKey) || '0', 10)));
    } else {
      setCount(parseInt(localStorage.getItem(localKey) || '0', 10));
    }

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    const animate = (n: number) => {
      if (reduceMotion) return;
      btn.classList.remove('pop');
      void (btn as HTMLElement).offsetWidth;
      btn.classList.add('pop');
      const fly = document.createElement('span');
      fly.className = 'heart-fly';
      fly.textContent = n % 10 === 0 ? '✨' : '♥';
      fly.style.left = `${8 + Math.random() * 24}px`;
      btn.appendChild(fly);
      setTimeout(() => fly.remove(), 900);
    };

    let taps = 0;
    btn.addEventListener('click', () => {
      taps++;
      animate(taps);
      if (noteEl && taps === 1) noteEl.textContent = 'thanks for the heart ♥';

      if (api && taps <= MAX_TAPS_PER_VISIT) {
        fetch(`${api}/hearts/${id}`, { method: 'POST' })
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => d && setCount(d.count))
          .catch(() => {});
      } else if (!api) {
        const n = parseInt(localStorage.getItem(localKey) || '0', 10) + 1;
        localStorage.setItem(localKey, String(n));
        setCount(n);
      }
    });

    // per-post view count (GoatCounter)
    if (gc && viewEl) {
      const path = encodeURIComponent(location.pathname);
      fetch(`https://${gc}.goatcounter.com/counter/${path}.json`)
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          if (d) {
            const n = parseInt(String(d.count).replace(/[^0-9]/g, ''), 10) || 0;
            viewEl.textContent = `${n} views`;
            viewEl.hidden = false;
          }
        })
        .catch(() => {});
    }
  }
</script>
