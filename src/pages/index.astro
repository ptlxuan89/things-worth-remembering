---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { url } from '../lib/url';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recent = posts.slice(0, 5);
---

<Base>
  <section class="hero">
    <h1>
      Hi, I'm xưn. I collect <span class="hl">things worth remembering</span> —
      from code, from people, from life.
    </h1>
    <p>
      Building AI products, collecting lessons, and staying curious about
      people, technology, and life. Some posts are technical, some are
      personal, some are three sentences long. All of them are honest.
    </p>
  </section>

  <section aria-label="Recent posts">
    <div class="post-list">
      {recent.map((post) => <PostCard post={post} />)}
    </div>
    <a href={url('/posts')}>all posts →</a>
  </section>
</Base>
